# 이 파일을 복사해 .env로 만든 뒤, 아래 값들을 실제 키로 채워 넣으세요.
#   cp .env.example .env
# 각 변수에 대한 설명은 docs/ENVIRONMENT.md 참고.
# .env 파일 자체는 절대 커밋하지 마세요 (.gitignore에 등록되어 있음).

# Claude (Anthropic) API Key
# 발급: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI API Key
# 발급: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Telegram Bot Token
# 발급: Telegram에서 @BotFather와 대화 후 생성
TELEGRAM_BOT_TOKEN=

# Telegram Chat ID (봇이 메시지를 보낼 대상, 보통 본인 개인 채팅)
# 확인: 봇에게 메시지를 한 번 보낸 뒤 https://api.telegram.org/bot<TOKEN>/getUpdates 응답의
#      result[0].message.chat.id 값을 사용하거나, @userinfobot과 대화해 본인 id를 확인
TELEGRAM_CHAT_ID=

# Slack App-Level Token (xapp-...) — Socket Mode 등에서 사용
# 발급: https://api.slack.com/apps → Basic Information → App-Level Tokens
SLACK_TOKEN=

# Slack Bot User OAuth Token (xoxb-...) — 메시지 전송 등 Bot API 호출에 사용
# 발급: https://api.slack.com/apps → OAuth & Permissions → Bot User OAuth Token
SLACK_BOT_USER_TOKEN=

# Google OAuth2 Client ID & Secret
# 발급: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Notion Integration Token
# 발급: https://www.notion.so/my-integrations
NOTION_API_KEY=